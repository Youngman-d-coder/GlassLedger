# Generate a long random value before deployment.
SECRET_KEY=replace-me-with-a-long-random-secret
SESSION_TIMEOUT_MINUTES=30
COOKIE_SECURE=0

# Local development (default if omitted): instance/inventory.db
# Railway persistent volume example: sqlite:////data/inventory.db
# DATABASE_URL=sqlite:////data/inventory.db
# BACKUP_DIR=/data/backups
# REPORT_DIR=/data/reports

# Optional Google Drive off-site backup.
# Create a Google service account, enable Drive API, share a Drive folder with the
# service-account email, then set these values.
# GOOGLE_SERVICE_ACCOUNT_FILE=/data/google-service-account.json
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id
AUTO_DRIVE_BACKUP=1
